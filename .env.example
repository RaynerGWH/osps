# Supabase project URL, for example https://your-project.supabase.co
SUPABASE_URL=

# Server-side secret key (sb_secret_...) or legacy service_role key.
# Do not use the public/anon key here.
SUPABASE_SECRET_KEY=

# Must match target_schema in supabase/create_poker_sessions.sql.
SUPABASE_SCHEMA=public
