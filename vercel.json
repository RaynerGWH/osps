{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "static",
  "regions": ["sin1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.env,.env.*,data/**,tests/**,.git/**,.github/**,work/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {"source": "/api/:path*", "destination": "/api/index"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}
      ]
    }
  ]
}
